# ==============================================================================
# Docker Compose environment template — copy to .env.dev / .env.prod and fill
# in real values. See DOCKER.md for the full deployment guide.
# ==============================================================================

# PostgreSQL is NOT containerized — this must point at an existing Postgres
# server reachable from the backend container (a local install on the same
# host works fine in dev via network_mode: host; use a real remote host in
# prod). Sensitive values can be stored encrypted instead of plaintext — run
# `cd api && python manage_secrets.py encrypt "your-secret-value"` and paste
# the resulting "enc:..." string here. See api/app/env_crypto.py / DOCKER.md.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/saypy_core

# JWT auth settings.
JWT_SECRET_KEY=change-me-to-a-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed CORS origins, or "*" for any origin (safe
# here since auth is a Bearer JWT header, not cookies).
CORS_ORIGINS=*

# Seed data created automatically on first startup if missing.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_CHURCH_NAMES=Kibada,KCC,Mwera,Goroka

# Optional — leave blank/unset unless the backend won't be reachable at
# "<the host/domain the browser used to load the frontend>:8001" (both
# App.jsx and the members-core api.js fall back to that automatically).
VITE_API_BASE_URL=
VITE_MEMBERS_API_BASE_URL=
