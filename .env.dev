# ==============================================================================
# Development environment — used by:  docker compose --env-file .env.dev up
# (a copy of this file is also kept as plain ".env" at the project root, since
# `docker compose up` with no --env-file flag only auto-loads ".env" — see
# DOCKER.md).
#
# The three secrets below are stored encrypted ("enc:...") using the local
# ./.secrets.key checked in for dev convenience only — see DOCKER.md before
# reusing this pattern anywhere near production. Decrypt/verify any of them
# with:
#   cd api && python manage_secrets.py decrypt "enc:...."
# ==============================================================================

# postgresql+psycopg://postgres:omi12345@localhost:5433/saypy_core
DATABASE_URL=enc:gAAAAABqqj1Gn1O_ZG7GyJ4irRpiDFLqWIhU3qlyDADMtBbzvSxSfd0ZCVT_VoKrcR9ftKmsQrYe0qV9AnJ-dg6kfL1taTIMvdNebsYrySFECA755Tom_dobAOfhCcavfaaMC_BK3fufLSiIr2LKWBBoswvV9emG6v5_i3xbb4TUubKk_M5dYOo=

# 0ab97c8224adfda5c656a52b230b52ca09aeac511df7da41c1a16fbc905edbcb
JWT_SECRET_KEY=enc:gAAAAABqqj1GNYcU92HCwLkabvrrUIvd8_-DmxKJHnS_KQBwfQbFBbiwGku6QIYxQfpxllEGeYK4fXgNcLBS5FPWMB6dVjG42E1ZAM_oq0E5YU1se4TP7QEg4qfWwnjvcwGcrAzNxk04Rrw0nxgDUxRnncSn7eDL0Oo57neWQD1gnbmuTFI_CoI=

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Dev frontend runs on localhost:5175 — "*" keeps things simple locally.
CORS_ORIGINS=*

SEED_ADMIN_USERNAME=admin
# ChangeMe123!
SEED_ADMIN_PASSWORD=enc:gAAAAABqqj1GtdpBRhw1OSTO3Oj-mO4c0eNS_R-7j7F8BK3RZpNgkNTQtB7nOrRZW3UP_8bq8IAM5mFv9PUDDyQVxrBrpTHGYA==

SEED_CHURCH_NAMES=Kibada,KCC,Mwera,Goroka

# Left unset — the `backend` service runs on host networking on 8001, so the
# automatic "<same host>:8001" fallback in App.jsx/api.js already resolves
# correctly with nothing set here.
VITE_API_BASE_URL=
VITE_MEMBERS_API_BASE_URL=
