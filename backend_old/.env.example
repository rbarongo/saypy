# Example env for backend
# Default (Postgres):
DB_ENGINE=postgres
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Optional SQLite mode:
# DB_ENGINE=sqlite
# SQLITE_PATH=./members.db

# Cloud/Postgres option A: single URL
# DB_ENGINE=postgres
# DATABASE_URL=postgresql://user:password@db-host:5432/dbname

# Cloud/Postgres option B: discrete variables (DATABASE_URL not required)
# DB_ENGINE=postgres
# PGHOST=db-host
# PGPORT=5432
# PGDATABASE=dbname
# PGUSER=dbuser
# PGPASSWORD=dbpassword

# Optional connection behavior for managed cloud DBs
# DB_SSLMODE=require
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
