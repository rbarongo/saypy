# Postgres connection for the new, independent saypy_core database.
# Same local Postgres server as backend_old, but a DIFFERENT database.
DATABASE_URL=postgresql+psycopg://postgres:omi12345@localhost:5433/saypy_core

# JWT settings for this API's own auth (independent of backend_old's token system).
JWT_SECRET_KEY=change-me-to-a-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed CORS origins, or "*" for any origin (safe
# here since auth is a Bearer JWT header, not cookies).
CORS_ORIGINS=*

# Seed data created automatically on first startup if missing.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_CHURCH_NAMES=Kibada,KCC,Mwera,Goroka
