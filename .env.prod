# ==============================================================================
# Production environment TEMPLATE — used by:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# This file contains PLACEHOLDER values only. Before deploying:
#
#   1. Generate a fresh production key (never reuse the dev .secrets.key):
#        cd api && python manage_secrets.py genkey
#      Save the output to a NEW ".secrets.key" file at the project root on the
#      production host only — never commit it, never copy the dev one over.
#
#   2. Encrypt each real secret with that key:
#        cd api && python manage_secrets.py encrypt "the-real-value"
#      Paste each resulting "enc:...." string into the matching variable
#      below. (Plaintext values are still accepted if you'd rather not
#      encrypt something like SEED_CHURCH_NAMES — only DATABASE_URL,
#      JWT_SECRET_KEY and SEED_ADMIN_PASSWORD support the enc: prefix.)
#
#   3. Point DATABASE_URL at your real production Postgres server/credentials.
#
#   4. Set CORS_ORIGINS to your real deployed frontend origin(s) — avoid "*"
#      in production.
#
# See DOCKER.md for the full walkthrough.
# ==============================================================================

DATABASE_URL=enc:REPLACE_WITH_ENCRYPTED_DATABASE_URL

JWT_SECRET_KEY=enc:REPLACE_WITH_ENCRYPTED_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Comma-separated list of real production origin(s), e.g.:
#   https://churchapp.example.org
CORS_ORIGINS=https://your-production-domain.example

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=enc:REPLACE_WITH_ENCRYPTED_SEED_ADMIN_PASSWORD

SEED_CHURCH_NAMES=Kigamboni

# Optional — leave unset unless the backend won't be reachable at
# "<the domain the frontend is served from>:8001" (see DOCKER.md).
VITE_API_BASE_URL=
VITE_MEMBERS_API_BASE_URL=
