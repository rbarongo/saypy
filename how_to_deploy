```bash
# Without Docker
cd /opt/saypy-collection/api && sudo -u saypy .venv/bin/python - <<'PY'
from app.database import SessionLocal
from app.models import User
from app.security import hash_password
db = SessionLocal()
u = db.query(User).filter(User.username == 'admin').first()
u.password_hash = hash_password('NewPassword123!'); db.commit(); print('reset', u.username)
PY

